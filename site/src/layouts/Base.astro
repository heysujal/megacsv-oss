---
import "../styles/global.css";
import { APP_URL } from "../data/home";
import fontUrl from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Structured data objects, each written as its own JSON-LD script. */
  jsonld?: object[];
  /** Social-share card, a path under public/ (1200x630). Defaults to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Set on blog posts: the share preview is an article with these dates. */
  article?: { published: Date; modified: Date };
  /** Keep the page out of search results (the 404 page): no canonical, robots noindex. */
  noindex?: boolean;
}

const {
  title,
  description,
  jsonld = [],
  ogImage = "/og.png",
  ogImageAlt = "MegaCSV: open CSV files too big for Excel. A grid showing row 18,402,116 of a 48-million-row file.",
  article,
  noindex = false,
} = Astro.props;
// Builds write /blog/post.html (`build.format: "file"`), but the page is served and linked as /blog/post.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/", Astro.site).href;
const nav = [
  ["How it works", "/#how"],
  ["Questions", "/#faq"],
  ["Fixes", "/fixes"],
  ["Blog", "/blog"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="MegaCSV" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    {
      article && (
        <Fragment>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={article.modified.toISOString()} />
          <meta property="article:section" content="Blog" />
        </Fragment>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#f3f4f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Apply a saved theme before first paint; otherwise the system setting decides.
      const t = localStorage.getItem("megacsv-theme");
      if (t) document.documentElement.classList.add(t);
    </script>
    {jsonld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {
      import.meta.env.PROD && (
        <Fragment>
          {/* Google Analytics and Microsoft Clarity, production builds only; asks visitors in Europe first (same file as the app). */}
          <script is:inline src="/consent.js" />
        </Fragment>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href="/"><img src="/whale.svg" alt="" width="28" height="28" /><span translate="no">MegaCSV</span></a>
      <nav class="links" aria-label="Main">{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
      <span class="sp"></span>
      <a class="btn navcta" href={APP_URL} data-cta="nav" data-open>Open a CSV file</a>
      <button class="iconbtn" type="button" data-theme aria-label="Switch between light and dark">
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"></path></svg>
      </button>
      <details class="menu">
        <summary aria-label="Menu"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></summary>
        <nav aria-label="Main">{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
      </details>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="inner">
        <div>
          <a class="brand" href="/"><img src="/whale.svg" alt="" width="22" height="22" /><span translate="no">MegaCSV</span></a>
          <p>Open CSV files too big for Excel.</p>
        </div>
        <nav aria-label="Footer">
          <a href="/about">About</a>
          <a href="/facts">Facts</a>
          <a href="/fixes">Fixes</a>
          <a href="/blog">Blog</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/privacy#cookies" data-consent-settings>Cookie settings</a>
        </nav>
        <slot name="foot-note" />
      </div>
    </footer>
    <script is:inline>
      document.querySelector("[data-theme]").addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.classList.contains("dark") ||
          (!root.classList.contains("light") && matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        root.classList.remove("light", "dark");
        root.classList.add(next);
        localStorage.setItem("megacsv-theme", next);
      });
      // Close the phone menu after following one of its links.
      document.querySelectorAll(".menu nav a").forEach((a) =>
        a.addEventListener("click", () => a.closest("details").removeAttribute("open")),
      );
      document.querySelectorAll("[data-cta]").forEach((a) =>
        a.addEventListener("click", () => {
          window.gtag?.("event", "cta_click", { page: location.pathname, button: a.dataset.cta });
          window.clarity?.("event", "cta_click");
        }),
      );
      // FAQ answers opened, by question number (docs/tasks.md §3).
      document.querySelectorAll(".faq details").forEach((d, i) =>
        d.addEventListener("toggle", () => {
          if (d.open) window.gtag?.("event", "faq_open", { page: location.pathname, question: i + 1 });
        }),
      );
      // Lets Clarity recordings be filtered by kind of page and by blog post.
      const path = location.pathname.replace(/\.html$/, "");
      window.clarity?.("set", "page_type", path === "/" ? "home" : path.startsWith("/blog/") ? "blog_post" : path.slice(1) || "home");
      if (path.startsWith("/blog/")) window.clarity?.("set", "post", path.slice(6));
    </script>
  </body>
</html>
