---
import Guide from "../components/Guide.astro";
import { guides } from "../lib/live";

// Problem pages, one per error message, built from their publish date on (the dev server builds all).
export async function getStaticPaths() {
  return (await guides("problems")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---

<Guide entry={entry} path={`/${entry.id}`} section="Fixes" sectionHref="/fixes" />
